# Variable names only. Never put real values in this file or commit a .env file.
# Credentials are normally stored in your OS keychain by `social init` / `social connect`.
# Environment variables are an alternative for headless use (CI, Docker, cron).

# Where socialledger keeps config, the SQLite store and report runs (default: ~/.socialledger)
SOCIALLEDGER_HOME=

# Passphrase for the encrypted-file token store (only used when no OS keychain is available)
SOCIALLEDGER_TOKEN_PASSPHRASE=

# YouTube (Google Cloud OAuth client, type "Desktop app")
SOCIALLEDGER_YOUTUBE_CLIENT_ID=
SOCIALLEDGER_YOUTUBE_CLIENT_SECRET=

# Meta (Instagram + Facebook)
SOCIALLEDGER_META_APP_ID=
SOCIALLEDGER_META_APP_SECRET=

# LinkedIn
SOCIALLEDGER_LINKEDIN_CLIENT_ID=
SOCIALLEDGER_LINKEDIN_CLIENT_SECRET=

# TikTok
SOCIALLEDGER_TIKTOK_CLIENT_KEY=
SOCIALLEDGER_TIKTOK_CLIENT_SECRET=

# Optional third-party public-data provider for competitor research
SCRAPECREATORS_API_KEY=
