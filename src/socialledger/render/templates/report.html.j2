<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:">
<title>Social report · {{ r.brand }}</title>
<style>
:root { --bg:#fff; --fg:#1d1d1f; --muted:#6b6b70; --line:#e4e4e7; --card:#f7f7f8; --good:#1a7f37; --bad:#c62828; --warn:#9a6700; }
@media (prefers-color-scheme: dark) { :root { --bg:#121214; --fg:#ececef; --muted:#a0a0a8; --line:#2c2c31; --card:#1b1b1f; --good:#4ac26b; --bad:#ff7b72; --warn:#d29922; } }
* { box-sizing:border-box; }
body { margin:0; background:var(--bg); color:var(--fg); font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif; }
main { max-width:960px; margin:0 auto; padding:24px 16px 64px; }
h1 { font-size:1.6rem; margin:0 0 4px; } h2 { margin:40px 0 8px; font-size:1.25rem; }
.meta { color:var(--muted); font-size:.9rem; }
.note { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:10px 14px; font-size:.9rem; }
.kpis { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; margin:12px 0; }
.kpi { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:12px; }
.kpi b { display:block; font-size:1.35rem; font-variant-numeric:tabular-nums; }
.kpi span { color:var(--muted); font-size:.8rem; }
.table-wrap { overflow-x:auto; }
table { border-collapse:collapse; width:100%; margin:8px 0 16px; font-variant-numeric:tabular-nums; }
th, td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--line); }
td.n, th.n { text-align:right; }
.up { color:var(--good); } .down { color:var(--bad); } .na { color:var(--muted); }
.badge { display:inline-block; padding:1px 8px; border-radius:99px; border:1px solid var(--line); font-size:.75rem; color:var(--muted); }
.dq td:nth-child(2) { color:var(--warn); white-space:nowrap; }
a { color:inherit; }
</style>
</head>
<body>
<main>
<h1>Social report: {{ r.brand }}</h1>
<p class="meta">{{ r.period.start }} → {{ r.period.end }} ({{ r.period.label }}, {{ r.period.days }} days) · compared with {{ r.comparison_period.start }} → {{ r.comparison_period.end }}<br>
Generated {{ r.generated_at.strftime("%Y-%m-%d %H:%M UTC") }} · run {{ r.run_id }} · socialledger {{ r.tool_version }}</p>
{% if r.demo %}<p class="note" style="border-color:var(--warn)"><b>Synthetic demo data.</b> Generated by <code>social demo</code>; not from any real account.</p>{% endif %}
<p class="note">All numbers are computed by socialledger from locally stored snapshots. “—” means unavailable, never zero. See <a href="#data-quality">Data quality</a>.</p>

{% for s in r.platforms %}
<section>
<h2>{{ s.platform | platform_name }} {% for src in s.sources %}<span class="badge">{{ src.value }}</span> {% endfor %}</h2>
{% if not s.has_data %}
<p class="na">No data stored for this period.</p>
{% else %}
<div class="kpis">
  <div class="kpi"><span>Followers</span><b>{{ s.followers.end | num }}</b><span>change {{ s.followers.change | num }} · {{ s.followers.method }}</span></div>
  <div class="kpi"><span>Engagement rate</span><b>{{ s.engagement_rate.value | pct(false) }}</b><span>{{ s.engagement_rate.formula }}{% if s.engagement_rate.reason %} · {{ s.engagement_rate.reason }}{% endif %}</span></div>
  <div class="kpi"><span>Posts published</span><b>{{ s.posts_published }}</b><span>in period</span></div>
</div>
<div class="table-wrap"><table>
<thead><tr><th>Metric</th><th class="n">This period</th><th class="n">Previous</th><th class="n">Change</th><th class="n">Days with data</th></tr></thead>
<tbody>
{% for m, ms in s.metrics.items() %}
<tr><td>{{ m.value }}</td><td class="n{% if ms.current.value is none %} na{% endif %}">{{ ms.current.value | num }}</td><td class="n{% if ms.previous.value is none %} na{% endif %}">{{ ms.previous.value | num }}</td>
<td class="n {% if ms.change_pct is none %}na{% elif ms.change_pct >= 0 %}up{% else %}down{% endif %}">{{ ms.change_pct | pct }}</td><td class="n">{{ ms.current.days_available }}/{{ ms.current.days_total }}</td></tr>
{% endfor %}
</tbody></table></div>
{% if s.format_mix %}
<div class="table-wrap"><table>
<thead><tr><th>Format</th><th class="n">Posts</th><th class="n">Share of posts</th><th class="n">Share of views</th></tr></thead>
<tbody>{% for f in s.format_mix %}<tr><td>{{ f.format }}</td><td class="n">{{ f.posts }}</td><td class="n">{{ f.share_of_posts | pct(false) }}</td><td class="n">{{ f.share_of_views | pct(false) }}</td></tr>{% endfor %}</tbody>
</table></div>
{% endif %}
{% for title, rows in [("Top posts", s.top_posts), ("Bottom posts (recent posts have had less time to accumulate views)", s.bottom_posts)] if rows %}
<h3>{{ title }} <span class="badge">by {{ s.posts_ranked_by }}, lifetime-to-date</span></h3>
<div class="table-wrap"><table>
<thead><tr><th>Post</th><th>Format</th><th>Published</th><th class="n">Views</th><th class="n">Engagements</th></tr></thead>
<tbody>{% for p in rows %}<tr><td>{% if p.url %}<a href="{{ p.url }}" rel="noopener noreferrer">{{ p.title or p.post_id }}</a>{% else %}{{ p.title or p.post_id }}{% endif %}</td><td>{{ p.format }}</td><td>{{ p.published_at[:10] }}</td><td class="n">{{ p.views | num }}</td><td class="n">{{ p.engagements | num }}</td></tr>{% endfor %}</tbody>
</table></div>
{% endfor %}
{% endif %}
</section>
{% endfor %}

<section id="data-quality">
<h2>Data quality</h2>
{% if not r.data_quality.items and not r.data_quality.csv_sourced_metrics %}
<p>No gaps detected.</p>
{% else %}
<div class="table-wrap"><table class="dq">
<thead><tr><th>Platform</th><th>Kind</th><th>Metric</th><th>Detail</th></tr></thead>
<tbody>{% for i in r.data_quality.items %}<tr><td>{{ i.platform.value }}</td><td>{{ i.kind }}</td><td>{{ i.metric or "—" }}</td><td>{{ i.detail }}</td></tr>{% endfor %}</tbody>
</table></div>
{% if r.data_quality.csv_sourced_metrics %}<p>CSV-imported metrics: {{ r.data_quality.csv_sourced_metrics | join(", ") }}</p>{% endif %}
{% endif %}
</section>
</main>
</body>
</html>
